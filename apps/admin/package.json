{
  "name": "@sonora/admin",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@sonora/shared": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "expo": "57.0.31",
    "expo-constants": "57.0.22",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.29",
    "expo-symbols": "57.0.3",
    "i18next": "catalog:",
    "nativewind": "5.0.0-rc.1",
    "postcss": "catalog:",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "catalog:",
    "react-native": "0.86.3",
    "react-native-css": "3.0.7",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "0.21.4",
    "tailwindcss": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@babel/runtime": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "19.2.15",
    "eslint": "catalog:",
    "eslint-config-expo": "57.0.2",
    "eslint-plugin-i18next": "6.1.5",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "catalog:"
  },
  "scripts": {
    "dev": "expo start --web --port 8082",
    "web": "expo export --platform web",
    "export:web": "expo export --clear --platform web",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --watchAll=false"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.bun/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-reanimated|react-native-gesture-handler|@react-native-async-storage/async-storage|@react-native-community/.*))"
    ]
  }
}
