{
  "name": "@sonora/admin",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@sonora/shared": "workspace:*",
    "@tailwindcss/postcss": "4.3.0",
    "expo": "56.0.15",
    "expo-constants": "56.0.20",
    "expo-linking": "56.0.15",
    "expo-router": "56.2.14",
    "expo-symbols": "56.0.6",
    "i18next": "26.3.0",
    "nativewind": "5.0.0-preview.4",
    "postcss": "8.5.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.8",
    "react-native": "0.85.3",
    "react-native-css": "3.0.7",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "0.21.2",
    "tailwindcss": "4.3.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.15",
    "eslint": "9.39.4",
    "eslint-config-expo": "56.0.4",
    "eslint-plugin-i18next": "6.1.5",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "dev": "expo start --web --port 8082",
    "web": "expo export --platform web",
