{
  "name": "@sonora/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/caveat": "0.4.2",
    "@expo/ui": "56.0.23",
    "@expo/vector-icons": "15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "21.14.0",
    "@react-native-firebase/app": "21.14.0",
    "@react-native-firebase/crashlytics": "21.14.0",
    "@sonora/shared": "workspace:*",
    "@tailwindcss/postcss": "4.3.0",
    "expo": "56.0.17",
    "expo-application": "56.0.3",
    "expo-asset": "56.0.21",
    "expo-audio": "56.0.13",
    "expo-background-fetch": "56.0.23",
    "expo-constants": "56.0.22",
    "expo-device": "56.0.4",
    "expo-file-system": "56.0.8",
    "expo-font": "56.0.7",
    "expo-glass-effect": "56.0.4",
    "expo-image": "56.0.11",
    "expo-linear-gradient": "56.0.4",
    "expo-linking": "56.0.16",
    "expo-localization": "56.0.6",
    "expo-location": "56.0.22",
    "expo-router": "56.2.16",
    "expo-splash-screen": "56.0.14",
    "expo-sqlite": "56.0.5",
    "expo-status-bar": "56.0.4",
    "expo-symbols": "56.0.6",
    "expo-system-ui": "56.0.5",
    "expo-task-manager": "56.0.23",
    "expo-web-browser": "56.0.6",
    "firebase": "11.3.1",
    "i18next": "26.3.6",
    "nativewind": "5.0.0-preview.4",
    "postcss": "8.5.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.11",
    "react-native": "0.85.3",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "4.3.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/leaflet": "1.9.21",
    "@types/react": "19.2.15",
    "eslint": "9.39.5",
    "eslint-config-expo": "56.0.4",
    "eslint-plugin-i18next": "6.1.5",
    "firebase-tools": "15.22.4",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "lightningcss": "1.30.1",
    "prettier": "3.8.3",
    "promise": "8.3.0",
    "react-doctor": "0.5.8",
    "react-test-renderer": "19.2.3",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start -c",
    "android": "expo run:android",
    "android-dev": "expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web -c",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchAll",
    "doctor": "npx react-doctor@latest",
    "firebase-cli": "./node_modules/.bin/firebase"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "\\.(css|png|jpg|jpeg|gif|svg)$": "<rootDir>/__mocks__/styleMock.ts",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/api/",
      "/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.bun/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-reanimated|react-native-gesture-handler|@react-native-async-storage/async-storage|@react-native-community/.*))"
    ]
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "private": true
}
