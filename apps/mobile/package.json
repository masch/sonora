  "devDependencies": {
    "@babel/runtime": "catalog:",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.2.15",
    "eslint": "catalog:",
    "eslint-config-expo": "57.0.2",
    "eslint-plugin-i18next": "6.1.5",
    "firebase-tools": "15.34.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "lightningcss": "catalog:",
    "prettier": "3.9.10",
    "react-doctor": "0.9.22",
    "react-test-renderer": "19.2.3",
    "test-renderer": "1.2.0",
    "typescript": "catalog:"
  },
  "scripts": {
    "start": "expo start -c",
    "export:web": "expo export --clear --platform web",
    "android": "expo run:android",
    "android-dev": "expo start --android",
    "ios": "expo run:ios",
    "start-web": "expo start --web -c",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchAll",
    "doctor": "react-doctor",
    "firebase-cli": "firebase"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "\\.(css|png|jpg|jpeg|gif|svg)$": "<rootDir>/__mocks__/styleMock.ts",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^maplibre-gl$": "<rootDir>/src/test-utils/maplibre-gl-double.ts",
      "^@maplibre/maplibre-react-native$": "<rootDir>/src/test-utils/maplibre-react-native-double.tsx"
    },
    "testPathIgnorePatterns": [
      "/api/",
      "/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.bun/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-reanimated|react-native-gesture-handler|@react-native-async-storage/async-storage|@react-native-community/.*))"
    ]
  },
  "private": true
}
