{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      }
    },
    "aab": {
      "android": {
        "buildType": "app-bundle"
      },
      "credentialsSource": "local",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "1"
      }
    }
  }
}
