# API URL for the deployed backend (set after deploying to Cloudflare Workers)
# Production: EXPO_PUBLIC_API_URL=https://sonora-api.<subdomain>.workers.dev
# Staging:    EXPO_PUBLIC_API_URL=https://sonora-api-staging.<subdomain>.workers.dev
# Empty/unset → falls back to localhost:3000 (or 10.0.2.2:3000 for Android emulator)
EXPO_PUBLIC_API_URL=""
