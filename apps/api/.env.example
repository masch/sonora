# Local port for Node dev server (default: 3000)
PORT=3000

# Postgres local database URL (Docker Compose)
DATABASE_URL=postgres://sonora:sonora@localhost:5432/sonora

# CORS Allowed Origin (local frontend dev)
ALLOWED_ORIGIN=http://localhost:8081

# ── Neon Cloud Database URLs (set after creating Neon projects) ──
# DATABASE_URL_STAGING="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb"
# DATABASE_URL_PRODUCTION="postgresql://user:password@ep-yyy.us-east-2.aws.neon.tech/neondb"

# ── MercadoPago Payment Integration ──
# MercadoPago access token (TEST-xxxx for sandbox, APP_USR-xxxx for production)
MP_ACCESS_TOKEN=
# MercadoPago webhook secret (used for webhook signature validation)
MP_WEBHOOK_SECRET=
# Default payment provider (default: mercadopago)
DEFAULT_PAYMENT_PROVIDER=mercadopago
