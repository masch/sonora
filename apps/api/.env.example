# Local port for Node dev server (default: 3000)
PORT=3000

# Postgres local database URL (Docker Compose)
DATABASE_URL=postgres://sonora:sonora@localhost:5432/sonora

# CORS Allowed Origin (local frontend dev)
ALLOWED_ORIGIN=http://localhost:8081

# ── Neon Cloud Database URLs (set after creating Neon projects) ──
