#!/bin/sh

set -e

# 0. Restore expo-env.d.ts if expo-cli trampled it
_f="apps/mobile/expo-env.d.ts"
if ! git diff --quiet "$_f" 2>/dev/null; then
  if git show HEAD:"$_f" 2>/dev/null | diff - "$_f" >/dev/null 2>&1; then
    : # no diff or binary
  else
    printf 'pre-commit: %s was modified by expo-cli — reverting\n' "$_f"
    git checkout -- "$_f"
  fi
fi
unset _f

# 1. Format code
make format

# 2. Stage the formatted files so gga reviews the final version
git add -u

# 3. Run all validation steps (collect all failures; run API if files changed)
STATUS=0
make test   || STATUS=$?
make lint   || STATUS=$?
make typecheck || STATUS=$?
make doctor-diff || STATUS=$?
make expo-doctor || echo "pre-commit: expo-doctor: known bun false positives — not blocking commit" >&2
if git diff --cached --name-only -- 'apps/api/*' | grep -q .; then
  make api-validate || STATUS=$?
fi
make gga    || { [ $? -eq 2 ] && echo "pre-commit: gga: no matching files — skipping" >&2; } || STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo "pre-commit: validation failed (exit $STATUS)."
fi
exit $STATUS
