#!/bin/sh

set -e

# 0. Restore expo-env.d.ts if expo-cli trampled it
_f="apps/mobile/expo-env.d.ts"
if ! git diff --quiet "$_f" 2>/dev/null; then
  if git show HEAD:"$_f" 2>/dev/null | diff - "$_f" >/dev/null 2>&1; then
    : # no diff or binary
  else
    printf 'pre-commit: %s was modified by expo-cli — reverting\n' "$_f"
    git checkout -- "$_f"
  fi
fi
unset _f

# 1. Check code formatting
make format-check

# 3. Run all validation steps (collect all failures; run API if files changed)
FAILED_TARGETS=""

run_step() {
  NAME=$1
  CMD=$2
  echo "Running $NAME..."
  if ! eval "$CMD"; then
    FAILED_TARGETS="$FAILED_TARGETS $NAME"
  fi
}

run_step "make test" "make test"
run_step "make lint" "make lint"
run_step "make typecheck" "make typecheck"
run_step "make doctor-diff" "make doctor-diff"
echo "Running make expo-doctor..."
make expo-doctor || echo "pre-commit: expo-doctor: known bun false positives — not blocking commit" >&2

if git diff --cached --name-only -- 'apps/api/*' | grep -q .; then
  run_step "make api-validate" "make api-validate"
fi

# gga returns 2 if no files are matched, which is not a failure.
echo "Running make gga..."
GGA_STATUS=0
make gga || GGA_STATUS=$?
if [ $GGA_STATUS -ne 0 ] && [ $GGA_STATUS -ne 2 ]; then
  FAILED_TARGETS="$FAILED_TARGETS make-gga"
fi

if [ -n "$FAILED_TARGETS" ]; then
  echo "pre-commit: Validation failed on targets:$FAILED_TARGETS"
  exit 1
fi

exit 0
