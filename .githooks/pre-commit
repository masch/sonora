#!/bin/sh

set -e

# 0. Restore expo-env.d.ts if expo-cli trampled it
_f="apps/mobile/expo-env.d.ts"
if ! git diff --quiet "$_f" 2>/dev/null; then
  if git show HEAD:"$_f" 2>/dev/null | diff - "$_f" >/dev/null 2>&1; then
    : # no diff or binary
  else
    printf 'pre-commit: %s was modified by expo-cli — reverting\n' "$_f"
    git checkout -- "$_f"
  fi
fi
unset _f

# 1. Check code formatting
printf "  ✓ format-check... "
if make format-check-staged > /dev/null 2>&1; then
  printf "ok\n"
else
  printf "fixed\n"
  make format-staged > /dev/null 2>&1
  git add -u
fi

# 2. Run all validation steps (fail-fast on first error)

# A log file nobody else can point somewhere else.
#
# The old name was `/tmp/sonora-precommit-<timestamp>-<name>.log`: predictable, so another
# local user could pre-create the path as a symlink and the redirection would truncate a
# file this developer owns. `mktemp` creates the file itself, under a name nobody can
# guess, and fails rather than reusing a path someone else already made.
new_log() {
  mktemp "${TMPDIR:-/tmp}/sonora-precommit-XXXXXXXX"
}

# The one way a step fails: say why, name the log, and show it.
#
# The log path is part of the message and the file is kept, because a failure a developer
# can only read once, in a terminal they are about to lose, is a failure they cannot work
# from. Every failing step goes through here, so no step can refuse a commit in silence.
fail_step() {
  printf 'FAILED (%s)\n' "$1"
  printf '  log: %s\n' "$2"
  cat "$2"
  exit 1
}

run_step() {
  NAME=$1
  CMD=$2
  ALLOWED_EXIT=${3:-}
  printf "  ✓ %s... " "$NAME"
  TMPFILE=$(new_log)
  if eval "$CMD" > "$TMPFILE" 2>&1; then
    printf "ok\n"
    rm -f "$TMPFILE"
  else
    EXIT_CODE=$?
    if [ -n "$ALLOWED_EXIT" ] && [ "$EXIT_CODE" = "$ALLOWED_EXIT" ]; then
      printf "skipped (exit %d)\n" "$EXIT_CODE"
      cat "$TMPFILE"
      rm -f "$TMPFILE"
    else
      fail_step "exit $EXIT_CODE" "$TMPFILE"
    fi
  fi
}

run_step "test-ci" "make test-ci"
run_step "lint" "make lint"
run_step "typecheck" "make typecheck"
run_step "doctor-ci" "make doctor-ci"

# expo-doctor is non-blocking (known bun false positives)
printf "  ✓ expo-doctor... "
TMPFILE=$(new_log)
if make expo-doctor > "$TMPFILE" 2>&1; then
  printf "ok\n"
else
  RESULT=$(grep -oP '\d+/\d+ checks passed' "$TMPFILE" || echo "checks failed")
  printf "%s — non-blocking\n" "$RESULT"
fi
rm -f "$TMPFILE"

# gga: 0 = passed/no files, 1 = violations found (blocks commit).
#
# Its exit code cannot be trusted alone: with STRICT_MODE off, a provider that is
# unreachable, out of funds or naming a model that no longer exists exits **0** after
# printing the failure — the gate then reports "ok" having reviewed nothing, which is
# how several commits passed a review that never ran. Strict mode catches that but
# also rejects a verdict the model words differently, and this repo's only usable
# models are the free tiers, which do word it differently. So the failure is detected
# here instead: a run that says its provider failed is a failed step, whatever it
# exits with.
#
# The status is captured the way `run_step` captures it — an `if`, not a bare command
# followed by `$?` — because the hook runs under `set -e`: a failing `make gga` aborted
# the script on the spot, so the provider-failure check below, and the message that tells
# a developer why their commit was refused, never ran.
printf "  ✓ %s... " "gga"
TMPFILE=$(new_log)
if make gga > "$TMPFILE" 2>&1; then
  GGA_EXIT=0
else
  GGA_EXIT=$?
fi
if grep -qE 'Provider execution failed|Model unavailable|Insufficient account funds|STRICT MODE: Failing' "$TMPFILE"; then
  fail_step "provider did not review" "$TMPFILE"
fi
if [ "$GGA_EXIT" -ne 0 ]; then
  fail_step "exit $GGA_EXIT" "$TMPFILE"
fi
printf "ok\n"
rm -f "$TMPFILE"

echo "  ✓ All checks passed"
exit 0
