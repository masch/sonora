#!/usr/bin/env bash
#
# An `npx` that speaks this repository's package manager.
#
# The root manifest declares its versions in Bun's `catalog:` protocol, and npm cannot
# read it: every npm or npx invocation at the repository root dies before running
# anything, with EUNSUPPORTEDPROTOCOL ("Unsupported URL Type \"catalog:\""). The
# override on the same package only changes the message, to EOVERRIDE, which is what the
# Android staging deploy reported.
#
# EAS local builds start their own plugin with `npx -y`, so any job that builds locally
# with EAS fails here while that is true. This shim is placed on PATH for those jobs
# only: it forwards the call to bunx, which reads the same catalogue, and drops the
# flags whose meaning bunx already implies.
#
# It is a workaround, not a fix. The durable answer is to stop routing the local build
# through npm at all; the reasoning and the alternatives live in the issue this was
# opened with.
set -euo pipefail

if ! command -v bunx >/dev/null 2>&1; then
  echo "npx shim: bunx is required, because the catalogue is a Bun feature" >&2
  echo "npx shim: refusing to fall back to npm, which cannot read it" >&2
  exit 127
fi

args=()
for arg in "$@"; do
  case "$arg" in
    # `npx -y` and `npx --yes` skip the install prompt. bunx does not prompt.
    -y | --yes) continue ;;
    *) args+=("$arg") ;;
  esac
done

exec bunx ${args[@]+"${args[@]}"}
