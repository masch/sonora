# Gentleman Guardian Angel Configuration
# https://github.com/your-org/gga

# AI Provider (required)
# Options: claude, gemini, codex, opencode, ollama:<model>, lmstudio[:model], github:<model>
# Examples:
#   PROVIDER="claude"
#   PROVIDER="gemini"
#   PROVIDER="codex"
#   PROVIDER="opencode"
#   PROVIDER="opencode:anthropic/claude-opus-4-5"
#   PROVIDER="ollama:llama3.2"
#   PROVIDER="ollama:codellama"
#   PROVIDER="lmstudio"
#   PROVIDER="lmstudio:qwen2.5-coder-7b-instruct"
#   PROVIDER="github:gpt-4o"
#   PROVIDER="github:deepseek-r1"
# This repo deliberately stays on the free tier, and deliberately avoids the
# `opencode-go/*` subscription namespace. That namespace is a paid plan whose quota is
# shared with anything else running on it; when it runs out, every commit's review fails
# with "Model unavailable" / "Insufficient account funds" and the pre-commit hook refuses
# the commit. `AGENTS.md` forbids `--no-verify`, so a contributor whose plan is exhausted
# cannot commit at all. Keep this provider free so the hook works for someone with no paid
# plan, and so exhausting a shared quota can never block committing.
#
# The free models live in the bare `opencode/*` namespace. Run `opencode models` to see
# which free models the installed catalog actually offers, and verify the exact name
# before changing it: a model that left the catalog fails the same way a missing plan
# does, and `gga run` exits 0 after saying so, which is why `.githooks/pre-commit` checks
# the output instead of trusting the exit code.
#
# `PROVIDER` below is the default: this file is loaded after the environment, so setting
# PROVIDER on the command line changes nothing. The override is `GGA_PROVIDER`, and it
# works for a one-off run or for a single commit:
#   GGA_PROVIDER="opencode:opencode/deepseek-v4.1-flash-free" make gga
#   GGA_PROVIDER="opencode:opencode/deepseek-v4.1-flash-free" git commit
PROVIDER="opencode:opencode/deepseek-v4.1-flash-free"

# File patterns to include in review (comma-separated)
# Default: * (all files)
# Examples:
#   FILE_PATTERNS="*.ts,*.tsx"
#   FILE_PATTERNS="*.py"
#   FILE_PATTERNS="*.go,*.mod"
FILE_PATTERNS="*.ts,*.tsx,*.js,*.jsx"
#FILE_PATTERNS="apps/mobile/**"
#FILE_PATTERNS="apps/api/**"
#FILE_PATTERNS="packages/**"

# File patterns to exclude from review (comma-separated)
# Default: none
# Examples:
#   EXCLUDE_PATTERNS="*.test.ts,*.spec.ts"
#   EXCLUDE_PATTERNS="*_test.go,*.mock.ts"
EXCLUDE_PATTERNS="*.test.ts,*.spec.ts,*.test.tsx,*.spec.tsx,*.d.ts"

# File containing code review rules
# Default: AGENTS.md
RULES_FILE="AGENTS.md"

# Strict mode: fail if AI response is ambiguous
# Default: true
STRICT_MODE="false"

# Timeout in seconds for AI provider response
# Default: 300 (5 minutes)
# Increase for large changesets or slow connections
TIMEOUT="600"

# Base branch for --pr-mode (auto-detects main/master/develop if empty)
# Default: auto-detect
# PR_BASE_BRANCH="main"
